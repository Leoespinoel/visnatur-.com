# Copy to .env.local and fill in. Never commit .env.local.
# On Hostinger: Websites → your site → Environment variables (same names).

# Public URL of the site (no trailing slash). Used for metadata, the sitemap and the Shopify webhook.
# visnaturæ.com is written in its ASCII form.
NEXT_PUBLIC_SITE_URL=https://xn--visnatur-q0a.com

# Shopify store, e.g. vis-naturae.myshopify.com (the .myshopify.com address, not your own domain).
SHOPIFY_STORE_DOMAIN=

# Storefront API: Headless sales channel → your storefront → Storefront API → private access token.
# Used server side to create carts and send buyers to Shopify checkout.
SHOPIFY_STOREFRONT_TOKEN=

# Admin API: a Dev Dashboard app installed on the store (client credentials).
# Scopes: read_products, write_products, read_orders, read_all_orders, write_orders,
#         read_publications, write_publications
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
